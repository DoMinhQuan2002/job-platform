PORT=4000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Optional alias if your team uses DB_USERNAME
# DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=job_platform

# For Supabase/managed Postgres usually set true
DB_SSL=true

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public bucket: avatars, company logos/icons
SUPABASE_STORAGE_BUCKET=job-platform-assets
# Private bucket: resumes (PDF). Create this bucket as Private in Supabase dashboard.
SUPABASE_STORAGE_PRIVATE_BUCKET=job-platform-private

# S3-compatible endpoint for Supabase Storage
# (Optional - useful for integrations expecting S3 endpoint)
SUPABASE_STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3

# Upstash Redis (REST). Copy URL + token from Upstash console.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ---------------------------------------------------------------
# Auth (Nhóm 1)
# ---------------------------------------------------------------
# Bí mật ký JWT access token (bắt buộc). Sinh bằng: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Cookie refresh_token. Contract yêu cầu Secure; chạy local qua http thì đặt false.
# Bỏ trống -> tự bật khi NODE_ENV=production.
COOKIE_SECURE=false

# Google OAuth - lấy Client ID (Web application) trong Google Cloud Console.
# FE dùng Google Identity Services để lấy idToken, BE verify lại với ID này.
GOOGLE_CLIENT_ID=163515871284-qq4b4jgbqt2nj0iltgfl8bk3apn2v48t.apps.googleusercontent.com

# SMTP gửi OTP. Bỏ trống SMTP_HOST -> OTP được in ra console (chỉ dùng khi dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@job-platform.local

# ---------------------------------------------------------------
# CORS & Rate limit (dùng chung cả 4 nhóm)
# ---------------------------------------------------------------
# Allowlist origin của FE, phân tách bằng dấu phẩy. Bắt buộc khai báo đủ,
# vì dùng cookie nên không thể dùng wildcard "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Số hop proxy tin cậy, để req.ip là IP thật của client khi rate limit.
# false = chạy trực tiếp; true / số (vd. 1) = có reverse proxy đứng trước.
TRUST_PROXY=false
